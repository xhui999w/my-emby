# ============================================================
# Go-Emby（复刻版）环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 不配置 DATABASE_URL 也能运行（自动回退 JSON 文件存储）
# ============================================================

# ---------- 基础 ----------
HTTP_PORT=8097
SERVER_NAME=Go-Emby
ADMIN_PASSWORD=
BOOTSTRAP_API_KEY=
PUBLIC_URL=
MEDIA_ROOTS=/media
MEDIA_PATH=./media
# 首次扫描按一级子目录自动拆分媒体库（/media/国产剧、/media/华语电影 … 各建一库）
# 设为 false 则整个 MEDIA_ROOTS 建为单个库
MEDIA_AUTO_SPLIT=true
APP_DATA_PATH=./app-data
TZ=Asia/Shanghai

# ---------- PostgreSQL ----------
# 设置后启用 PostgreSQL 持久化；留空则回退到 JSON 文件（APP_DATA_PATH/db.json）
# 直接本地运行示例：postgres://postgres:postgres@127.0.0.1:5432/goemby?sslmode=disable
DATABASE_URL=
# compose 里的 postgres 服务参数
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=goemby
POSTGRES_DATA_PATH=./postgres-data

# ---------- TMDB 元数据刮削 ----------
# 留空则不刮削；填入 TMDB v3 API Key 后，扫描时自动补齐简介/年份/海报
TMDB_API_KEY=
TMDB_LANGUAGE=zh-CN
# 可自定义（如反代 / 测试用）
TMDB_BASE=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# ---------- 文件管理 ----------
# 文件管理器允许访问的根目录（容器内路径），默认取第一个媒体根
FILE_MANAGER_ROOT=

# ---------- ffmpeg 缩略图 ----------
THUMBNAIL_ENABLED=true
FFMPEG_PATH=ffmpeg

# ---------- 媒体库实时监听 / 增量扫描 ----------
# 轮询式监听媒体目录，检测到增/删/改自动按库增量重扫
WATCH_ENABLED=true
WATCH_INTERVAL_SEC=8

# ---------- ffprobe 媒体信息探测 ----------
# 自动提取真实分辨率/编码/音轨/字幕/时长；需系统有 ffprobe
PROBE_ENABLED=true
# ffprobe 可执行路径（在 PATH 中可只写 ffprobe）
FFPROBE_PATH=ffprobe
PROBE_CONCURRENCY=2

# ---------- 豆瓣刮削（扩展数据源，与 TMDB 组成多源） ----------
# 开启后，TMDB 缺失时用豆瓣 subject_suggest 补年份/海报
DOUBAN_ENABLED=false
DOUBAN_BASE=https://movie.douban.com

# ---------- Xiaoya / OpenList(WebDAV) STRM 同步 ----------
# 例：XIAOYA_SOURCE=http://192.168.1.10:5244/dav/电影
XIAOYA_SOURCE=
XIAOYA_USERNAME=dav
XIAOYA_PASSWORD=
# 定时同步间隔（分钟），0 表示不定时；也可在后台手动触发
XIAOYA_INTERVAL_MIN=0
# 写入 .strm 的直链前缀；留空则用 SOURCE 把 /dav 替换为 /d
XIAOYA_PUBLIC_BASE=
# .strm 落盘目录（默认 APP_DATA_PATH/strm，compose 已挂载）
STRM_PATH=./app-data/strm

# ---------- 授权（免费模式留空） ----------
LICENSE_KEY=
LICENSE_SERVER_URL=https://tl.macacaaca.top
# 开启后强制授权校验：未授权对所有接口返回 402（/health、/license/status 除外）
LICENSE_ENFORCE=false
